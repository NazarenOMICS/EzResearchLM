{
  "permissions": {
    "allow": [
      "Bash(ez *)",
      "Bash(.venv/bin/ez *)",
      "Bash(.venv\\Scripts\\ez *)",
      "Bash(.venv\\Scripts\\ez.exe *)",
      "Bash(python scripts/validate.py*)",
